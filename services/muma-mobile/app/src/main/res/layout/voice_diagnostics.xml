<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="?attr/colorSurface"
    a:orientation="vertical">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="horizontal"
        a:padding="12dp">

        <EditText
            a:id="@+id/voice_diagnostics_input"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:autofillHints=""
            a:hint="@string/voice_diagnostics_hint"
            a:imeOptions="actionSearch"
            a:inputType="text"
            a:textColor="?attr/colorOnSurface"
            a:textColorHint="?attr/colorOnSurfaceVariant" />

        <Button
            a:id="@+id/voice_diagnostics_clear"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginStart="8dp"
            a:text="@string/voice_diagnostics_clear" />
    </LinearLayout>

    <TextView
        a:id="@+id/voice_diagnostics_empty"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:padding="16dp"
        a:text="@string/voice_diagnostics_empty"
        a:textAppearance="?attr/textAppearanceBodyMedium"
        a:textColor="?attr/colorOnSurfaceVariant"
        a:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        a:id="@+id/voice_diagnostics_list"
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:clipToPadding="false"
        a:paddingBottom="16dp" />
</LinearLayout>
