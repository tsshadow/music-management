[Unit]
Description=MuMa CI runner disk janitor
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
# Runs as the user whose Docker socket access it needs. On a GitLab runner host
# that is the runner user; on Teun's workstation it is user. Both are in the
# docker group, so no root is required and none is taken.
User=gitlab-runner
ExecStart=/opt/muma-disk-janitor/disk-janitor.sh
# A full disk is not an emergency worth a failed unit in the journal every
# hour: the script exits 1 only when it has swept all it safely can and is
# still critical, and that state persists until someone acts on it.
SuccessExitStatus=0 1
