<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="?android:attr/colorBackground"
    a:fillViewport="true">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingTop="8dp"
        a:paddingBottom="80dp">

        <include
            a:id="@+id/section_memories"
            layout="@layout/home_section" />

        <include
            a:id="@+id/section_shortcuts"
            layout="@layout/home_section" />

        <include
            a:id="@+id/section_released"
            layout="@layout/home_section" />

        <include
            a:id="@+id/section_added"
            layout="@layout/home_section" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
