<?xml version="1.0" encoding="utf-8"?>
<!--
     A track as a home screen row.

     Deliberately not a card: what identifies a track is its title and artist, not its artwork, and a
     large part of the library (SoundCloud, YouTube) has no artwork at all. The text therefore gets
     the room, and the 40dp square is only a hint.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="56dp"
    a:background="?attr/selectableItemBackground"
    a:paddingHorizontal="6dp">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/card_image"
        a:layout_width="40dp"
        a:layout_height="40dp"
        a:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/unknown_album" />

    <TextView
        a:id="@+id/card_title"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="12dp"
        a:layout_marginEnd="8dp"
        a:ellipsize="end"
        a:maxLines="1"
        a:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        a:textColor="@color/spotify_text_primary"
        app:layout_constraintBottom_toTopOf="@+id/card_subtitle"
        app:layout_constraintEnd_toStartOf="@+id/card_trailing"
        app:layout_constraintStart_toEndOf="@+id/card_image"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="Silence" />

    <TextView
        a:id="@+id/card_subtitle"
        a:layout_width="0dp"
        a:layout_height="wrap_content"
        a:layout_marginStart="12dp"
        a:layout_marginEnd="8dp"
        a:ellipsize="end"
        a:maxLines="1"
        a:textAppearance="@style/TextAppearance.Material3.BodySmall"
        a:textColor="@color/spotify_text_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/card_trailing"
        app:layout_constraintStart_toEndOf="@+id/card_image"
        app:layout_constraintTop_toBottomOf="@+id/card_title"
        tools:text="Sub Zero Project · Renegades" />

    <LinearLayout
        a:id="@+id/card_trailing"
        a:layout_width="wrap_content"
        a:layout_height="wrap_content"
        a:gravity="end"
        a:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            a:id="@+id/card_meta"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            a:textColor="@color/spotify_text_secondary"
            tools:text="4:12" />

        <LinearLayout
            a:id="@+id/card_rating"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginTop="2dp"
            a:orientation="horizontal"
            a:visibility="gone"
            tools:visibility="visible">

            <ImageView
                a:id="@+id/card_star_1"
                a:layout_width="10dp"
                a:layout_height="10dp"
                a:contentDescription="@null"
                a:src="@drawable/ic_star_hollow" />

            <ImageView
                a:id="@+id/card_star_2"
                a:layout_width="10dp"
                a:layout_height="10dp"
                a:contentDescription="@null"
                a:src="@drawable/ic_star_hollow" />

            <ImageView
                a:id="@+id/card_star_3"
                a:layout_width="10dp"
                a:layout_height="10dp"
                a:contentDescription="@null"
                a:src="@drawable/ic_star_hollow" />

            <ImageView
                a:id="@+id/card_star_4"
                a:layout_width="10dp"
                a:layout_height="10dp"
                a:contentDescription="@null"
                a:src="@drawable/ic_star_hollow" />

            <ImageView
                a:id="@+id/card_star_5"
                a:layout_width="10dp"
                a:layout_height="10dp"
                a:contentDescription="@null"
                a:src="@drawable/ic_star_hollow" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
