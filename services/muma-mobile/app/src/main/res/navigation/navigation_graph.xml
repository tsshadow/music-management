<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_graph"
    app:startDestination="@id/mainFragment">

    <action
        android:id="@+id/toTrackCollection"
        app:destination="@id/trackCollectionFragment" />
    <action
        android:id="@+id/toBookmarks"
        app:destination="@id/bookmarksFragment" />
    <action
        android:id="@+id/toMemories"
        app:destination="@id/memoriesFragment" />
    <action
        android:id="@+id/toMediaLibrary"
        app:destination="@id/mediaLibraryFragment" />
    <action
        android:id="@+id/toAlbumList"
        app:destination="@id/albumListFragment" />
    <action
        android:id="@+id/toArtistList"
        app:destination="@id/artistListFragment" />
    <action
        android:id="@+id/toSongList"
        app:destination="@id/selectSongFragment" />
    <action
        android:id="@+id/toSearchFragment"
        app:destination="@id/searchFragment" />
    <action
        android:id="@+id/toPlaylistFragment"
        app:destination="@id/playlistsFragment" />
    <!-- Global action so NavigationActivity's first-run welcome dialog (login) can navigate to
         the Google access-request flow directly, the same way EditServerFragment's local
         "toGoogleAuth" action does. -->
    <action
        android:id="@+id/toGoogleAuthGlobal"
        app:destination="@id/googleAuthFragment" />

    <fragment
        android:id="@+id/mainFragment"
        android:name="nl.teunschriks.mumamobile.fragment.MainFragment"
        android:label="@string/common_appname">
    </fragment>

    <fragment
        android:id="@+id/favoritesFragment"
        android:name="nl.teunschriks.mumamobile.fragment.FavoritesFragment"
        android:label="@string/filter.favorites" />

    <fragment
        android:id="@+id/memoriesFragment"
        android:name="nl.teunschriks.mumamobile.fragment.MemoriesFragment"
        android:label="@string/library.tab_memories" />

    <fragment
        android:id="@+id/libraryFragment"
        android:name="nl.teunschriks.mumamobile.fragment.LibraryFragment"
        android:label="@string/library.label" />

    <fragment
        android:id="@+id/managementFragment"
        android:name="nl.teunschriks.mumamobile.management.ManagementFragment"
        android:label="@string/management.label" />

    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="nl.teunschriks.mumamobile.fragment.ArtistListFragment"
        android:label="@string/music_library.label" />
    <fragment
        android:id="@+id/nowPlayingFragment"
        android:name="nl.teunschriks.mumamobile.fragment.NowPlayingFragment"
        android:label="@string/button_bar.now_playing" />
    <fragment
        android:id="@+id/artistListFragment"
        android:name="nl.teunschriks.mumamobile.fragment.ArtistListFragment">
        <argument
            android:name="refresh"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="title"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
    </fragment>
    <fragment
        android:id="@+id/trackCollectionFragment"
        android:name="nl.teunschriks.mumamobile.fragment.TrackCollectionFragment">
        <argument
            android:name="id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="artistId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="isAlbum"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="isArtist"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="getRandom"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="getStarred"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="getVideos"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="autoPlay"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="shuffle"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="refresh"
            android:defaultValue="true"
            app:argType="boolean" />
        <argument
            android:name="name"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="parentId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="songs"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="filters"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
        <argument
            android:name="year"
            android:defaultValue=""
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="genre"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="artists"
            android:defaultValue="@null"
            app:argType="string[]"
            app:nullable="true" />
        <argument
            android:name="festival"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="label"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="length"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="ratingMin"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="ratingMax"
            android:defaultValue="5"
            app:argType="integer" />
        <argument
            android:name="festivalLineup"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="shareId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="playlistId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="playlistName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="shareName"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="podcastChannelId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="albumListType"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="size"
            android:defaultValue="-1"
            app:argType="integer" />
        <argument
            android:name="offset"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="sortMethod"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="minDuration"
            android:defaultValue="-1"
            app:argType="integer" />
        <argument
            android:name="maxDuration"
            android:defaultValue="-1"
            app:argType="integer" />
    </fragment>
    <fragment
        android:id="@+id/albumListFragment"
        android:name="nl.teunschriks.mumamobile.fragment.AlbumListFragment">
        <argument
            android:name="type"
            app:argType="nl.teunschriks.mumamobile.api.subsonic.models.AlbumListType" />
        <argument
            android:name="byArtist"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="title"
            app:argType="string"
            android:defaultValue="@null"
            app:nullable="true" />
        <argument
            android:name="size"
            android:defaultValue="20"
            app:argType="integer" />
        <argument
            android:name="offset"
            android:defaultValue="0"
            app:argType="integer"/>
        <argument
            android:name="sortMethod"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="append"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="refresh"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="artistId"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <action
            android:id="@+id/albumListToTrackCollection"
            app:destination="@id/trackCollectionFragment" />
    </fragment>
    <fragment
        android:id="@+id/searchFragment"
        android:name="nl.teunschriks.mumamobile.fragment.SearchFragment">
        <action
            android:id="@+id/searchToTrackCollection"
            app:destination="@id/trackCollectionFragment" />
        <action
            android:id="@+id/searchToAlbumsList"
            app:destination="@id/albumListFragment" />
        <argument
            android:name="query"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true" />
        <argument
            android:name="autoplay"
            android:defaultValue="false"
            app:argType="boolean" />
    </fragment>
    <fragment
        android:id="@+id/playlistsFragment"
        android:name="nl.teunschriks.mumamobile.fragment.legacy.PlaylistsFragment">
    </fragment>
    <fragment
        android:id="@+id/downloadsFragment"
        android:name="nl.teunschriks.mumamobile.fragment.DownloadsFragment" />
    <fragment
        android:id="@+id/sharesFragment"
        android:name="nl.teunschriks.mumamobile.fragment.legacy.SharesFragment">
    </fragment>
    <fragment
        android:id="@+id/bookmarksFragment"
        android:name="nl.teunschriks.mumamobile.fragment.BookmarksFragment" />
    <fragment
        android:id="@+id/chatFragment"
        android:name="nl.teunschriks.mumamobile.fragment.legacy.ChatFragment" />
    <fragment
        android:id="@+id/podcastFragment"
        android:name="nl.teunschriks.mumamobile.fragment.legacy.PodcastFragment">
    </fragment>
    <fragment
        android:id="@+id/settingsFragment"
        android:name="nl.teunschriks.mumamobile.fragment.SettingsFragment" />
    <fragment
        android:id="@+id/aboutFragment"
        android:name="nl.teunschriks.mumamobile.fragment.AboutFragment" />
    <fragment
        android:id="@+id/logViewerFragment"
        android:name="nl.teunschriks.mumamobile.fragment.LogViewerFragment" />
    <fragment
        android:id="@+id/voiceCommandsFragment"
        android:name="nl.teunschriks.mumamobile.fragment.VoiceCommandsFragment" />
    <fragment
        android:id="@+id/voiceDiagnosticsFragment"
        android:name="nl.teunschriks.mumamobile.fragment.VoiceDiagnosticsFragment" />
    <fragment
        android:id="@+id/selectSongFragment"
        android:name="nl.teunschriks.mumamobile.fragment.muma.SelectSongFragment"/>
    <fragment
        android:id="@+id/playerFragment"
        android:name="nl.teunschriks.mumamobile.fragment.PlayerFragment">
        <action
            android:id="@+id/playerToSelectAlbum"
            app:destination="@id/trackCollectionFragment" />
        <action
            android:id="@+id/playerToAlbumsList"
            app:destination="@id/albumListFragment" />
        <action
            android:id="@+id/playerToLyrics"
            app:destination="@id/lyricsFragment" />
        <action
            android:id="@+id/playerToEqualizer"
            app:destination="@id/equalizerFragment" />
    </fragment>
    <fragment
        android:id="@+id/lyricsFragment"
        android:name="nl.teunschriks.mumamobile.fragment.legacy.LyricsFragment">
        <argument
            android:name="artist"
            app:argType="string" />
        <argument
            android:name="title"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/equalizerFragment"
        android:name="nl.teunschriks.mumamobile.fragment.EqualizerFragment" />
    <fragment
        android:id="@+id/serverSelectorFragment"
        android:name="nl.teunschriks.mumamobile.fragment.ServerSelectorFragment">
        <action
            android:id="@+id/toEditServer"
            app:destination="@id/editServerFragment" />
    </fragment>
    <fragment
        android:id="@+id/editServerFragment"
        android:name="nl.teunschriks.mumamobile.fragment.EditServerFragment">
        <argument
            android:name="index"
            android:defaultValue="-1"
            app:argType="integer" />
        <action
            android:id="@+id/toGoogleAuth"
            app:destination="@id/googleAuthFragment" />
    </fragment>

    <fragment
        android:id="@+id/googleAuthFragment"
        android:name="nl.teunschriks.mumamobile.fragment.GoogleAuthFragment">
        <argument
            android:name="status"
            app:argType="string" />
        <argument
            android:name="displayName"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="email"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="avatarUrl"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="idToken"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <action
            android:id="@+id/toGoogleAuth"
            app:destination="@id/googleAuthFragment" />
    </fragment>
</navigation>
