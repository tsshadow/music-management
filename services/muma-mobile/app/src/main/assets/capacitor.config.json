{
  "appId": "nl.teunschriks.mumamobile",
  "appName": "MuMa",
  "webDir": "dist",
  "backgroundColor": "#121212",
  "android": {
    "path": "../muma-mobile",
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "http"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    },
    "SystemBars": {
      "style": "DARK"
    }
  }
}
