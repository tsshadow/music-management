<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ Where you are, in the one place the app can always show it. The web marks the active
  ~ destination white and leaves the other three grey; every icon here used to be colorPrimary,
  ~ so all four were brand green at once and the bar carried no information.
  -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?android:attr/textColorPrimary" android:state_checked="true" />
    <item android:color="?android:attr/textColorSecondary" />
</selector>
