<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:background="?attr/selectableItemBackground"
    a:orientation="vertical"
    a:paddingStart="16dp"
    a:paddingTop="10dp"
    a:paddingEnd="16dp"
    a:paddingBottom="10dp">

    <TextView
        a:id="@+id/voice_trace_summary"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:textAppearance="?attr/textAppearanceBodyMedium"
        a:textColor="?attr/colorOnSurface" />

    <HorizontalScrollView
        a:id="@+id/voice_trace_detail_scroll"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="8dp"
        a:visibility="gone">

        <TextView
            a:id="@+id/voice_trace_detail"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:fontFamily="monospace"
            a:textAppearance="?attr/textAppearanceBodySmall"
            a:textColor="?attr/colorOnSurfaceVariant"
            a:textIsSelectable="true" />
    </HorizontalScrollView>

    <View
        a:layout_width="match_parent"
        a:layout_height="1dp"
        a:layout_marginTop="10dp"
        a:background="?attr/rowSeam" />
</LinearLayout>
