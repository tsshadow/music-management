<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical">

    <LinearLayout
        a:id="@+id/manual_chapter_header"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:background="?attr/selectableItemBackground"
        a:gravity="center_vertical"
        a:orientation="horizontal"
        a:paddingStart="16dp"
        a:paddingTop="14dp"
        a:paddingEnd="16dp"
        a:paddingBottom="14dp">

        <ImageView
            a:id="@+id/manual_chapter_icon"
            a:layout_width="24dp"
            a:layout_height="24dp"
            a:layout_marginEnd="16dp"
            a:contentDescription="@null" />

        <TextView
            a:id="@+id/manual_chapter_title"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:textAppearance="?attr/textAppearanceTitleMedium"
            a:textColor="?attr/colorOnSurface" />

        <ImageView
            a:id="@+id/manual_chapter_chevron"
            a:layout_width="24dp"
            a:layout_height="24dp"
            a:contentDescription="@null"
            a:src="@drawable/ic_chevron_right" />

    </LinearLayout>

    <LinearLayout
        a:id="@+id/manual_chapter_content"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:paddingStart="16dp"
        a:paddingEnd="16dp"
        a:paddingBottom="16dp"
        a:visibility="gone">

        <TextView
            a:id="@+id/manual_chapter_body"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:lineSpacingMultiplier="1.15"
            a:textAppearance="?attr/textAppearanceBodyMedium"
            a:textColor="?attr/colorOnSurfaceVariant" />

        <ImageView
            a:id="@+id/manual_chapter_image"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="14dp"
            a:adjustViewBounds="true"
            a:background="?attr/selectableItemBackground"
            a:contentDescription="@string/manual.screenshot_description"
            a:maxHeight="360dp"
            a:scaleType="fitStart"
            a:visibility="gone" />

        <TextView
            a:id="@+id/manual_chapter_action"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginTop="14dp"
            a:background="?attr/selectableItemBackground"
            a:paddingStart="4dp"
            a:paddingTop="8dp"
            a:paddingEnd="4dp"
            a:paddingBottom="8dp"
            a:textAppearance="?attr/textAppearanceLabelLarge"
            a:textColor="?attr/colorPrimary"
            a:visibility="gone" />

    </LinearLayout>

    <View
        a:layout_width="match_parent"
        a:layout_height="1dp"
        a:background="?attr/rowSeam" />

</LinearLayout>
