# Android SDK image for the MuMa Mobile CI jobs.
#
# Two problems with using mobiledevops/android-sdk-image directly, which this
# solves: every job re-ran `sdkmanager` to install the same build-tools and
# platforms, and the container ran as root, leaving root-owned Gradle output in
# the workspace that broke the *next* job's checkout (hence the chown hook in
# .gitlab-ci.yml). Here the SDK is installed once at build time and handed to a
# uid that matches the runner user, so the container never writes as root.
#
# Build it with the runner's own uid/gid:
#   docker build -f docker/Dockerfile-android-ci \
#     --build-arg RUNNER_UID="$(id -u)" --build-arg RUNNER_GID="$(id -g)" \
#     -t music-management/android-ci:35 docker/
FROM mobiledevops/android-sdk-image:36.1.0@sha256:679b9b29374719ec1160515911d674292d5b00bbb47408eb623a5cbbde57ceb2

ARG RUNNER_UID=1000
ARG RUNNER_GID=1000

USER root

# Resolve the SDK location once and record it, so the scripts do not have to
# re-derive it with `find` on every run. The platforms directory is the only
# reliable landmark: the base image moves it between releases.
#
# API 37 is the first release with minor SDK versions, so the platform package
# is "platforms;android-37.0" -- plain "platforms;android-37" does not exist and
# sdkmanager only warns "Failed to find package" before exiting non-zero, which
# reads as a network problem rather than a wrong name.
RUN set -eux; \
    SDK_ROOT="$(find /opt /usr /usr/local -name platforms -type d -print -quit)"; \
    SDK_ROOT="${SDK_ROOT%/platforms}"; \
    test -n "$SDK_ROOT"; \
    echo "ANDROID_SDK_ROOT=$SDK_ROOT" > /etc/android-sdk-root; \
    yes | sdkmanager --sdk_root="$SDK_ROOT" --licenses >/dev/null 2>&1 || true; \
    sdkmanager --sdk_root="$SDK_ROOT" \
        "build-tools;37.0.0" "platforms;android-37.0" \
        "build-tools;36.0.0" "platforms;android-36" \
        "build-tools;35.0.0" "platforms;android-35" \
        "build-tools;34.0.0" "platforms;android-34"; \
    chown -R "$RUNNER_UID:$RUNNER_GID" "$SDK_ROOT"

# Emulator for scripts/test/muma-mobile-emulator-smoke.sh: the only thing that
# can execute an R8-minified release build (bug-report 029 existed only there).
# aosp_atd is the automated-test-device image - a stripped Android without
# launcher/GMS, made for exactly this - and android-34 is deliberate: the app's
# minSdk is far below it, ATD images stop at 34, and the emulator OS version
# does not need to match targetSdk. Runs on KVM (passed through on the runner
# LXC since 2026-08-22), hence hw acceleration; libpulse keeps qemu's audio
# stack from crashing headless.
RUN set -eux; \
    . /etc/android-sdk-root; \
    sdkmanager --sdk_root="$ANDROID_SDK_ROOT" \
        "platform-tools" "emulator" \
        "system-images;android-34;aosp_atd;x86_64"; \
    apt-get update && apt-get install -y --no-install-recommends \
        libpulse0 libxkbfile1 libxkbcommon0 libgl1 libegl1 libnss3 \
        libfontconfig1 libxcursor1 libxi6 \
        && rm -rf /var/lib/apt/lists/*; \
    chown -R "$RUNNER_UID:$RUNNER_GID" "$ANDROID_SDK_ROOT"

# The uid may already exist in the base image, in which case groupadd/useradd
# fail and are ignored - but the home directory still has to be there and
# writable, because Gradle puts its daemon registry under $HOME.
RUN set -eux; \
    groupadd -g "$RUNNER_GID" ci 2>/dev/null || true; \
    useradd -u "$RUNNER_UID" -g "$RUNNER_GID" -m -d /home/ci -s /bin/bash ci 2>/dev/null || true; \
    mkdir -p /home/ci; \
    chown -R "$RUNNER_UID:$RUNNER_GID" /home/ci

USER $RUNNER_UID:$RUNNER_GID
ENV HOME=/home/ci
