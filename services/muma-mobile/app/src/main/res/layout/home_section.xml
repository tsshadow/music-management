<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical"
    a:paddingTop="16dp">

    <!-- Title and "Show more" share a row: the action belongs to the section, and putting it at the
         end of the heading is what keeps it out of the scrolling content. -->
    <LinearLayout
        a:id="@+id/section_header"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:baselineAligned="true"
        a:orientation="horizontal"
        a:paddingHorizontal="16dp"
        a:paddingBottom="8dp">

        <TextView
            a:id="@+id/section_title"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            a:textColor="?android:attr/textColorPrimary"
            a:textStyle="bold"
            tools:text="Recently added" />

        <TextView
            a:id="@+id/section_more"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:background="?attr/selectableItemBackground"
            a:paddingHorizontal="4dp"
            a:text="@string/home.show_more"
            a:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            a:textColor="?android:attr/textColorSecondary"
            a:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- Shown until the section has loaded. The card placeholders are added at runtime, because
         which shape they take (grid or carousel) is a property of the section. -->
    <LinearLayout
        a:id="@+id/section_skeleton"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="vertical"
        a:visibility="gone">

        <View
            a:layout_width="160dp"
            a:layout_height="18dp"
            a:layout_marginHorizontal="16dp"
            a:layout_marginBottom="10dp"
            a:background="@drawable/skeleton_block" />

        <FrameLayout
            a:id="@+id/section_skeleton_cards"
            a:layout_width="match_parent"
            a:layout_height="wrap_content" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        a:id="@+id/section_recycler"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:clipToPadding="false"
        a:paddingHorizontal="10dp" />

</LinearLayout>
