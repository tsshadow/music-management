<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/spotify_black"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="16dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/artist_image"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:contentDescription="@string/select_artist.image_description"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_contact_picture"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Circle" />

    <TextView
        android:id="@+id/artist_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/spotify_text_primary"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/artist_image"
        app:layout_constraintTop_toTopOf="@id/artist_image"
        tools:text="Nine Inch Nails" />

    <TextView
        android:id="@+id/artist_subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/spotify_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/artist_image"
        app:layout_constraintTop_toBottomOf="@id/artist_title"
        tools:text="12 albums · 148 tracks" />

    <TextView
        android:id="@+id/artist_years"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/spotify_text_secondary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/artist_image"
        app:layout_constraintTop_toBottomOf="@id/artist_subtitle"
        tools:text="1989 – 2020" />

    <TextView
        android:id="@+id/artist_genres"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/spotify_text_secondary"
        app:layout_constraintEnd_toStartOf="@id/artist_play_all"
        app:layout_constraintStart_toEndOf="@id/artist_image"
        app:layout_constraintTop_toBottomOf="@id/artist_years"
        tools:text="Industrial, Rock" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/artist_play_all"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/select_album.play_all"
        app:backgroundTint="?attr/colorPrimary"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="@id/artist_image"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/media_start"
        app:tint="@android:color/white" />

</androidx.constraintlayout.widget.ConstraintLayout>
