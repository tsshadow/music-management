# Deployment Environment Configuration

# Service Tags (Overrides)
IMAGE_NAME=*/lms
LMS_TAG=latest

# Integration Settings
# NOTE: must include the "/api" prefix, e.g. http://music-management.example.com/api
MUSIC_MANAGEMENT_URL=http://music-management.example.com/api
MUSIC_MANAGEMENT_API_KEY=
LMS_SUBSONIC_API_KEY=
# The key MuMa presents when it calls this server's /muma routes (MuMa reads
# the same value as MUMA_SERVER_API_KEY / LMS_API_KEY). It is never handed to a
# user: the web login ("/muma/api/auth/login") is MuMa's own and answers with
# the user's own key.
LMS_API_KEY=

# Reverse proxy in front of this stack (issue #234)
# The proxies nginx takes the client address (X-Forwarded-For) from, besides
# loopback and the Docker networks. A comma or space separated list of
# addresses or CIDRs. Set it to the address of the reverse proxy on your LAN
# (for example Nginx Proxy Manager), or MuMa's login rate limit counts every
# login against that proxy's address. Leave it empty when nothing on the LAN
# sits in front of this stack. Never set a whole LAN range: port 80 is open to
# the LAN, and any host in a trusted range can name its own client address.
# Example:
# NGINX_TRUSTED_PROXY=192.0.2.30
NGINX_TRUSTED_PROXY=

# Google Sign-In (frontend build-time Client ID)
# Passed as a Docker build-arg (`--build-arg VITE_GOOGLE_CLIENT_ID=...`) when
# building the LMS image (Dockerfile-release), since it is compiled into the
# static frontend bundle at `npm run build` time. Must be the SAME Google
# Cloud "Web application" OAuth Client ID as the root `.env`'s
# GOOGLE_CLIENT_ID, otherwise the backend will reject the frontend's ID token
# (audience mismatch). Leaving it empty keeps the Google Sign-In button
# hidden, exactly as today.
VITE_GOOGLE_CLIENT_ID=

# Remote Deployment
DEPLOY_TARGET_NAME=LMS
REMOTE_HOST=
REMOTE_USER=
REMOTE_PASS=

# Discovery
PORTAINER_HOST=
