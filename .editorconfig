root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,ts,jsx,tsx,svelte,css,scss,json,yml,yaml}]
indent_size = 2

[*.{kt,kts,gradle}]
indent_size = 4

[*.{c,cc,cpp,h,hpp}]
indent_style = tab

[Makefile]
indent_style = tab

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false
