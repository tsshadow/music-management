<?xml version="1.0" encoding="utf-8"?>
<!-- Targeting Android 12 or higher -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!--include domain=["file" | "database" | "sharedpref" | "external" | "root"] path="string"/-->
        <!--exclude domain=["file" | "database" | "sharedpref" | "external" | "root"] path="string"/-->
        <exclude domain="root"/>
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <!-- Credentials (issue #115): ciphertext whose Keystore key never leaves the device, so a
             copy could not be opened anyway. Restored without it, the app is signed out. -->
        <exclude domain="sharedpref" path="muma_credentials.xml"/>
        <exclude domain="sharedpref" path="secure_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Without an include everything is transferred except what is excluded:
             https://developer.android.com/guide/topics/data/autobackup#include-exclude-android-11 -->
        <exclude domain="sharedpref" path="muma_credentials.xml"/>
        <exclude domain="sharedpref" path="secure_settings.xml"/>
    </device-transfer>
</data-extraction-rules>
