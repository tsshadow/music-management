<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="fill_parent"
    a:layout_height="fill_parent"
    a:orientation="vertical">

    <TextView
        a:id="@+id/select_playlist_empty"
        a:layout_width="fill_parent"
        a:layout_height="wrap_content"
        a:padding="16dip"
        a:text="@string/select_playlist.empty"
        a:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        a:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        a:id="@+id/select_playlist_bookmarks_row"
        a:layout_width="fill_parent"
        a:layout_height="wrap_content"
        a:minHeight="?android:attr/listPreferredItemHeight"
        a:orientation="horizontal"
        a:gravity="center_vertical"
        a:paddingStart="16dip"
        a:paddingEnd="16dip"
        a:background="?android:attr/selectableItemBackground"
        a:clickable="true"
        a:focusable="true">

        <ImageView
            a:layout_width="24dp"
            a:layout_height="24dp"
            a:importantForAccessibility="no"
            a:src="@drawable/ic_menu_bookmark" />

        <TextView
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginStart="16dip"
            a:text="@string/button_bar.bookmarks"
            a:textAppearance="?android:attr/textAppearanceLarge" />

    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/select_playlist_refresh"
        android:layout_width="fill_parent"
        android:layout_height="0dip"
        android:layout_weight="1.0">

        <ListView
            android:id="@+id/select_playlist_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</LinearLayout>
