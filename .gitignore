# docker-compose.yml
work-context/
# /docker-compose.tools.yml
/.env
*.sql
# Schema migrations are the exception: scripts/deploy.sh applies every
# migrate_*.sql in the repo root on each deploy, so these must be committed.
# Without this rule "git add" silently skips them and the deploy runs new code
# against an old schema - see docs/bug-reports/021-genre-migration-never-shipped.md.
!migrate_*.sql
*.log
.output.txt
venv/
.venv/
__pycache__/
.idea/
services/ml-analyzer/.env
node_modules/
.pytest_cache/
.production
# Coverage reports
coverage/
coverage-python.xml
coverage-lms.xml
cobertura-ultrasonic.xml
htmlcov/
.coverage
.coverage.*
# Tool caches
.mypy_cache/
.ruff_cache/
# Local runtime data (dev/music bind-mount contents for docker/docker-compose.dev.yml).
/data/
