<?xml version="1.0" encoding="utf-8"?>
<!--
  ~ muma_track_info.xml
  ~ The "now playing" info sheet: everything we know about one track, with the
  ~ artist and album rows doubling as navigation.
  -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/track_info_scroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:id="@+id/track_info_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/muma_sheet_handle" />

        <!-- Hero: the cover doubles as its own blurred backdrop. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:cardBackgroundColor="@color/spotify_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/track_info_backdrop"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:alpha="0.55"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/muma_track_info_scrim" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="14dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/track_info_cover"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:contentDescription="@string/track_info.cover_description"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/ShapeAppearance.TrackInfoCover" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/track_info_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="3"
                            android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                            android:textColor="@color/spotify_text_primary"
                            android:textStyle="bold"
                            tools:text="Strobe" />

                        <LinearLayout
                            android:id="@+id/track_info_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/track_info_star_1"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@null"
                                android:padding="2dp"
                                app:tint="?attr/colorPrimary" />

                            <ImageView
                                android:id="@+id/track_info_star_2"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@null"
                                android:padding="2dp"
                                app:tint="?attr/colorPrimary" />

                            <ImageView
                                android:id="@+id/track_info_star_3"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@null"
                                android:padding="2dp"
                                app:tint="?attr/colorPrimary" />

                            <ImageView
                                android:id="@+id/track_info_star_4"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@null"
                                android:padding="2dp"
                                app:tint="?attr/colorPrimary" />

                            <ImageView
                                android:id="@+id/track_info_star_5"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@null"
                                android:padding="2dp"
                                app:tint="?attr/colorPrimary" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation rows -->
        <LinearLayout
            android:id="@+id/track_info_artist_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_artist"
                app:tint="@color/spotify_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/track_info.artist"
                    style="@style/Ultrasonic.TrackInfo.Label" />

                <TextView
                    android:id="@+id/track_info_artist_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    style="@style/Ultrasonic.TrackInfo.Value"
                    tools:text="Deadmau5" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/spotify_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/track_info_album_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/baseline_music_note_24"
                app:tint="@color/spotify_text_secondary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/track_info.album"
                    style="@style/Ultrasonic.TrackInfo.Label" />

                <TextView
                    android:id="@+id/track_info_album_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:singleLine="true"
                    style="@style/Ultrasonic.TrackInfo.Value"
                    tools:text="For Lack of a Better Name" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/spotify_text_secondary" />
        </LinearLayout>

        <!-- Actions -->
        <HorizontalScrollView
            android:id="@+id/track_info_actions_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/track_info_action_lyrics"
                    style="@style/Ultrasonic.TrackInfo.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download.menu_lyrics"
                    app:icon="@drawable/ic_library" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/track_info_action_share"
                    style="@style/Ultrasonic.TrackInfo.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download.share_song"
                    app:icon="@drawable/ic_menu_share" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/track_info_action_bookmark"
                    style="@style/Ultrasonic.TrackInfo.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download.bookmark_set"
                    app:icon="@drawable/ic_menu_bookmark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/track_info_action_bookmark_delete"
                    style="@style/Ultrasonic.TrackInfo.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download.bookmark_delete"
                    app:icon="@drawable/ic_menu_bookmark" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/track_info_action_refresh"
                    style="@style/Ultrasonic.TrackInfo.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/download.menu_refresh_track"
                    app:icon="@drawable/ic_menu_refresh" />
            </LinearLayout>
        </HorizontalScrollView>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:background="@color/spotify_hover_light" />

        <!-- Facts. Every row hides itself when the track has nothing to say. -->
        <LinearLayout
            android:id="@+id/track_info_genre_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_info.genre"
                style="@style/Ultrasonic.TrackInfo.Label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/track_info_genre_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingVertical="0dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/track_info_track_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:text="@string/track_info.track_number"
                style="@style/Ultrasonic.TrackInfo.Label" />

            <TextView
                android:id="@+id/track_info_track_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Ultrasonic.TrackInfo.Value"
                tools:text="7 · disc 1" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/track_info_released_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:text="@string/track_info.released"
                style="@style/Ultrasonic.TrackInfo.Label" />

            <TextView
                android:id="@+id/track_info_released_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Ultrasonic.TrackInfo.Value"
                tools:text="2009" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/track_info_duration_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="104dp"
                android:layout_height="wrap_content"
                android:text="@string/track_info.duration"
                style="@style/Ultrasonic.TrackInfo.Label" />

            <TextView
                android:id="@+id/track_info_duration_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                style="@style/Ultrasonic.TrackInfo.Value"
                tools:text="10:37" />
        </LinearLayout>

        <!-- Technical details, folded away: useful when something sounds wrong,
             noise the rest of the time. -->
        <LinearLayout
            android:id="@+id/track_info_tech_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="52dp"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="14dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/track_info.technical"
                style="@style/Ultrasonic.TrackInfo.Label" />

            <ImageView
                android:id="@+id/track_info_tech_chevron"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:src="@drawable/arrow_drop_down"
                app:tint="@color/spotify_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/track_info_tech_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/track_info_format_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Ultrasonic.TrackInfo.Value"
                tools:text="320 kbps · mp3 · 24.3 MB" />

            <TextView
                android:id="@+id/track_info_path_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="monospace"
                android:longClickable="true"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="@color/spotify_text_secondary"
                tools:text="/music/Deadmau5/For Lack of a Better Name/07 Strobe.mp3" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
