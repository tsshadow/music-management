<?xml version="1.0" encoding="utf-8"?>
<!--
  The driving screen, top to bottom: the places you go, the microphone, and what is playing.

  Only the middle band stretches. The shortcuts and the player block are both wrap_content, so
  neither can be clipped by the other. The previous layout gave the shortcut grid a layout_weight
  and it lost every argument about height it had with the artwork, the transport and the stars.
-->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="?android:attr/colorBackground"
    a:orientation="vertical"
    a:paddingHorizontal="16dp">

    <ImageButton
        a:id="@+id/car_mode_close"
        a:layout_width="56dp"
        a:layout_height="56dp"
        a:layout_gravity="end"
        a:background="?attr/selectableItemBackgroundBorderless"
        a:contentDescription="@string/car_mode.close"
        a:src="@drawable/ic_menu_close" />

    <androidx.recyclerview.widget.RecyclerView
        a:id="@+id/car_mode_tiles"
        a:layout_width="match_parent"
        a:layout_height="wrap_content" />

    <!--
      The microphone owns every pixel the two fixed blocks do not, which is what makes it the thing
      the eye lands on. A filled circle rather than a bare icon: the old borderless button left the
      microphone floating on the background with nothing to aim at.
    -->
    <FrameLayout
        a:layout_width="match_parent"
        a:layout_height="0dp"
        a:layout_weight="1"
        a:minHeight="120dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            a:id="@+id/car_mode_microphone"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_gravity="center"
            a:contentDescription="@string/muma_voice_title"
            a:src="@drawable/ic_menu_microphone"
            app:backgroundTint="?attr/colorPrimary"
            app:elevation="6dp"
            app:fabCustomSize="160dp"
            app:maxImageSize="72dp"
            app:tint="?attr/colorOnPrimary" />

    </FrameLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginTop="8dp"
        a:gravity="center_vertical"
        a:orientation="horizontal">

        <ImageView
            a:id="@+id/car_mode_art"
            a:layout_width="72dp"
            a:layout_height="72dp"
            a:contentDescription="@null"
            a:scaleType="centerCrop"
            tools:src="@drawable/unknown_album" />

        <LinearLayout
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_marginStart="12dp"
            a:layout_weight="1"
            a:orientation="vertical">

            <TextView
                a:id="@+id/car_mode_title"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:maxLines="1"
                a:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                a:textColor="?android:attr/textColorPrimary"
                tools:text="Track title" />

            <TextView
                a:id="@+id/car_mode_artist"
                a:layout_width="match_parent"
                a:layout_height="wrap_content"
                a:ellipsize="end"
                a:maxLines="1"
                a:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                a:textColor="?android:attr/textColorSecondary"
                tools:text="Artist" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center"
        a:orientation="horizontal">

        <ImageButton
            a:id="@+id/car_mode_previous"
            a:layout_width="80dp"
            a:layout_height="80dp"
            a:background="?attr/selectableItemBackgroundBorderless"
            a:contentDescription="@string/buttons.previous"
            a:src="@drawable/media_backward" />

        <ImageButton
            a:id="@+id/car_mode_play_pause"
            a:layout_width="104dp"
            a:layout_height="104dp"
            a:background="?attr/selectableItemBackgroundBorderless"
            a:contentDescription="@string/buttons.play"
            a:src="@drawable/media_start" />

        <ImageButton
            a:id="@+id/car_mode_next"
            a:layout_width="80dp"
            a:layout_height="80dp"
            a:background="?attr/selectableItemBackgroundBorderless"
            a:contentDescription="@string/buttons.next"
            a:src="@drawable/media_forward" />

    </LinearLayout>

    <LinearLayout
        a:id="@+id/car_mode_stars"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:layout_marginBottom="8dp"
        a:gravity="center"
        a:orientation="horizontal" />

</LinearLayout>
