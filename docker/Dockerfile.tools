# Gebruik een lichte Python base image
FROM python:3.14-slim

# Installeer yt-dlp afhankelijkheden. mariadb-client hoort hier ook thuis: het
# levert mariadb-dump en mariadb voor tools/db_backup.py en
# tools/db_restore_check.py, die als db-backup en db-restore-check uit dit image
# draaien.
#
# De uitpakkers (unrar-free, p7zip-full, unar) stonden hier meegekopieerd uit
# Dockerfile.base en hoorden er nooit: alleen services/importer/extractor.py
# roept patoolib aan, en dat pakket wordt hieronder juist *niet* in deze image
# gekopieerd. Niets in tools/ of in de wel gekopieerde services importeert
# patoolib. `unar` was bovendien duur: het trekt via gnustep-base-runtime een
# complete build-essential mee (gcc, g++, binutils, libc6-dev en dus
# linux-libc-dev, plus graphviz), wat de enige reden was dat deze image de
# kernel-headers bevatte waar security:dependency-audit CVE's op meldde.
#
# apt-get upgrade: zie de toelichting in Dockerfile.base. De vooraf
# geinstalleerde openssl van python:3.14-slim beweegt niet mee met een rebuild
# van deze image.
# SECURITY_REFRESH changes every day (scripts/ci/build-and-push-images.sh), which
# is what makes the upgrade below actually run: with an unchanged Dockerfile the
# layer cache hands back the layer from the first build, upgrade and all. The
# LMS image deployed with 0.82.1 carried an `apk upgrade` layer from 11 days
# earlier, and with it a libexpat the repository had already fixed.
ARG SECURITY_REFRESH=unset
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    mariadb-client \
    && rm -rf /var/lib/apt/lists/*

# yt-dlp, pinned to the same version as requirements.txt and docker/Dockerfile.downloader
# (Renovate bumps the three together). Installed from PyPI rather than as the
# releases/latest/download/yt-dlp binary: that URL has no version in it, and a pinned
# binary URL would need a checksum Renovate cannot update. pip puts the same `yt-dlp`
# entry point in /usr/local/bin.
# renovate: datasource=pypi depName=yt-dlp
ARG YT_DLP_VERSION=2026.8.19
RUN pip install --no-cache-dir "yt-dlp==${YT_DLP_VERSION}"

# Zet de werkmap in de container
WORKDIR /app

# Kopieer requirements (indien aanwezig in de root of specifieke module)
# We gaan ervan uit dat we de requirements uit services/music_manager nodig hebben
COPY services/music_manager/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Kopieer de rest van de applicatie.
#
# Alleen de Python-pakketten die tools/ daadwerkelijk importeert. Dit was
# `COPY services/ /app/services/`, wat de complete boom meenam: de 18 MB
# Android-broncode van services/muma-mobile (inclusief testresources zoals
# core/subsonic-api/src/integrationTest/resources/self-signed.pem, een
# self-signed certificaat met private key dat een imagescan als HIGH secret
# aanmerkt), de Svelte-bron van services/frontend en de C++-bron van
# services/music-management-server. Niets daarvan is Python en niets daarvan
# wordt in deze image uitgevoerd.
#
# De lijst hieronder is de import-closure van tools/*.py:
#   common        - Helpers/, config_store, db_init (elk tool raakt dit)
#   tagger        - Song/SoundcloudSong (soundcloud_fetcher)
#   music_manager - database, routers/users, song_versions (set_password e.a.)
#   scanner, downloader - alleen omdat services.music_manager ze importeert
# Zie tools/test_tools_imports.py: die test bewaakt precies deze paden.
COPY services/__init__.py /app/services/
COPY services/common/ /app/services/common/
COPY services/tagger/ /app/services/tagger/
COPY services/scanner/ /app/services/scanner/
COPY services/downloader/ /app/services/downloader/
COPY services/music_manager/ /app/services/music_manager/
COPY tools/ /app/tools/

# De scripts die als eenmalige container uit deze image draaien
# (release-date-backfill en song-work-repair in docker-compose.tools.yml).
# scripts/ gaat bewust niet in zijn geheel mee: de rest is deploy- en CI-shell
# die op de runner hoort en niet in een productie-image. Hun import-closure
# (services/common, services/tagger, services/music_manager) staat hierboven al.
COPY scripts/backfill_release_dates.py scripts/seed_scene_group_date_formats.py \
     scripts/repair_song_works.py /app/scripts/
COPY VERSION RELEASE_NOTES.md /app/

# Set PYTHONPATH zodat de tool de services kan vinden
ENV PYTHONPATH=/app

# Standaard commando (kan overschreven worden in docker-compose)
CMD ["python", "tools/process_genres.py", "--run", "--interactive"]
