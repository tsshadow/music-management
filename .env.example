# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=music-management
DB_PASS=<>
DB_DB=music-management
MYSQL_ROOT_PASSWORD=

# App Configuration
debug=True
PHPMYADMIN_URL=<>>
import_folder_path=/mnt/music/EPs/__TODO
music_folder_path=/mnt/music
eps_folder_path=/mnt/music/EPs
delimiter=/

# Host Paths (adjust if your host music path is different)
HOST_MUSIC_PATH=/mnt/music
HOST_DATA_PATH=/docker/music-management

# Downloader Settings
youtube_folder=/mnt/music/Youtube
youtube_archive=/mnt/music/archives/youtube
youtube_accounts=/mnt/music/Youtube/accounts.txt
soundcloud_folder=/mnt/music/Soundcloud
soundcloud_archive=/mnt/music/archives/soundcloud
soundcloud_accounts=/mnt/music/Soundcloud/accounts.txt
telegram_folder=/mnt/music/Telegram

# Telegram API (Get these from my.telegram.org)
telegram_api_id=
telegram_api_hash=
telegram_session=music-management
telegram_accounts=

# Docker Configuration
DOCKER_USER=muma
IMAGE_ML=music-management-ml
IMAGE_TOOLS=music-management-tools
IMAGE_APP=music-management
IMAGE_MANAGEMENT=music-management-control

# Security
MUMA_API_KEY=<>
# API_KEY=
# USER_API_KEY=
# RATING_API_KEY=
# SCROBBLE_API_KEY=

# Rate limiting on /api/auth/login, /api/auth/refresh and /api/auth/setup.
# A user's api_key is accepted in place of their password (see
# docs/authentication.md), so an unlimited login endpoint is a guessing oracle
# against it. Counted over a sliding window, and only *rejected* attempts count:
# LMS re-checks the password against /api/auth/login on every Subsonic request,
# so successful traffic here is a library being browsed, not people logging in.
# A login is counted per account; the other two per client address, taken from
# the left-most X-Forwarded-For entry when behind a proxy.
# The counters are per process -- if music-manager is ever scaled to more than
# one replica these need to move to a shared store.
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_ENABLED=1

# Google Sign-In (RBAC / UserRequest flow)
# OAuth 2.0 "Web application" Client ID from Google Cloud Console. Used by
# music_manager to verify the `aud` claim of Google ID tokens sent by the web
# frontend and the Android app (the Android app must request its ID token
# with this same Web Client ID as the serverClientId/audience).
# IMPORTANT: must be the SAME value as VITE_GOOGLE_CLIENT_ID in
# services/music-management-server/.env, which is passed as a build-arg when
# building the LMS/frontend image. If they differ, the frontend's Google
# Sign-In button will render, but the backend will reject its ID token
# (audience mismatch, HTTP 401). See docs/deployment.md for the setup steps.
GOOGLE_CLIENT_ID=

# Artist Image Fetcher
ARTIST_IMAGE_STORAGE_PATH=/mnt/music/artists
ARTIST_IMAGE_PUBLIC_BASE_URL=/media/artist-images
ARTIST_IMAGE_DISABLE_FALLBACK=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# Remote Deployment (optional)
# Descriptive name for the deployment target (e.g., "Production Stack")
DEPLOY_TARGET_NAME=

# Option 1: Portainer Webhook
# NOTE: Stack Webhooks are a Business Edition feature. 
# For Community Edition, use Service Webhooks (one per service) or the SSH method below.
PORTAINER_WEBHOOK_URL=

# Option 2: SSH-based deployment
REMOTE_HOST=
REMOTE_USER=
REMOTE_PASS=
# Path to docker-compose.yml or its directory on the remote host
REMOTE_STACK_PATH=

# Option 3: Portainer Master Host (for template discovery)
# If your stack is managed by Portainer, the script can pull the template from here.
PORTAINER_HOST=
PORTAINER_HOST_USER=
PORTAINER_HOST_PASS=
