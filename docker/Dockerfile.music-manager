ARG DOCKER_USER=muma
ARG VERSION=latest

# Stage 1: Python Backend
FROM python:3.11-slim
WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    libmariadb-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY services/music_manager/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY VERSION /app/VERSION
COPY services/ /app/services/
COPY .env /app/.env

ENV PYTHONPATH=/app
EXPOSE 8000

CMD ["uvicorn", "services.music_manager.main:app", "--host", "0.0.0.0", "--port", "8000"]
