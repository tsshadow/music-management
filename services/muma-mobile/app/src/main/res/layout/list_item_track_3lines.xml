<?xml version="1.0" encoding="utf-8"?>
<!-- DON'T CONVERT TO ConstraintLayout! We have been there and it was slower than LinearLayout :) -->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:id="@+id/song_layout"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:minHeight="?android:attr/listPreferredItemHeight"
    a:orientation="horizontal"
    a:background="?attr/listRowBackground"
    a:foreground="?attr/rowSeam"
    a:paddingVertical="8dp"
    a:paddingHorizontal="16dp"
    a:layout_marginVertical="?attr/rowMarginVertical"
    a:layout_marginHorizontal="?attr/rowMarginHorizontal"
    a:elevation="0dp">

    <ImageView
        a:id="@+id/song_drag"
        a:layout_width="38dp"
        a:layout_height="fill_parent"
        a:background="@android:color/transparent"
        a:focusable="false"
        a:gravity="center_vertical"
        a:importantForAccessibility="no"
        a:paddingStart="7dip"
        a:paddingEnd="4dip"
        a:src="@drawable/ic_drag_vertical"
        a:visibility="gone" />

    <include layout="@layout/list_item_track_details_3lines" />

</LinearLayout>
