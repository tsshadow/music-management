<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="8dp"
        android:text="@string/welcome_login_info"
        android:textAppearance="?attr/textAppearanceSubtitle1" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/welcome_username_layout"
        style="@style/Widget.Ultrasonic.TextInputLayout.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/welcome_username">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/welcome_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/welcome_password_layout"
        style="@style/Widget.Ultrasonic.TextInputLayout.Filled"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/welcome_password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/welcome_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/spotify_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:letterSpacing="0.1"
            android:text="@string/welcome_or_divider"
            android:textColor="@color/spotify_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/spotify_card" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_google_signin"
        style="@style/Widget.Ultrasonic.Button.GoogleSignIn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/google_signin_button" />

    <ProgressBar
        android:id="@+id/welcome_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/welcome_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="?attr/colorError"
        android:visibility="gone" />

    <TextView
        android:id="@+id/welcome_target_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.5"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceCaption"
        android:visibility="gone" />

</LinearLayout>
