<?xml version="1.0" encoding="utf-8"?>
<!-- Stands in for a carousel of cards while it loads. Mirrors home_card_carousel.xml's sizes so
     the real cards land where the placeholders were, without the section jumping. -->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="horizontal"
    a:paddingHorizontal="10dp">

    <include layout="@layout/home_skeleton_carousel_card" />

    <include layout="@layout/home_skeleton_carousel_card" />

    <include layout="@layout/home_skeleton_carousel_card" />

</LinearLayout>
