# Deployment Environment Configuration

# Service Tags (Overrides)
IMAGE_NAME=*/lms
LMS_TAG=latest

# Integration Settings
# NOTE: must include the "/api" prefix, e.g. http://music-management.example.com/api
MUSIC_MANAGEMENT_URL=http://music-management.example.com/api
MUSIC_MANAGEMENT_API_KEY=
LMS_SUBSONIC_API_KEY=
# Required for the beheer/management page's login ("/muma/api/auth/login") to
# work: MumaResource.cpp only hands back a usable api_key when this is set to
# a non-empty value. Leaving it empty breaks beheer login for every user.
LMS_API_KEY=

# Remote Deployment
DEPLOY_TARGET_NAME=LMS
REMOTE_HOST=
REMOTE_USER=
REMOTE_PASS=

# Discovery
PORTAINER_HOST=
