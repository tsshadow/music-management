# docker-compose.yml
work-context/
# /docker-compose.tools.yml
/.env
*.sql
# Schema migrations are the exception: scripts/deploy.sh applies every
# migrate_*.sql in the repo root on each deploy, so these must be committed.
# Without this rule "git add" silently skips them and the deploy runs new code
# against an old schema - see docs/bug-reports/021-genre-migration-never-shipped.md.
!migrate_*.sql
# The seed rows a fresh database gets (services/common/db_seeds.py).
!services/common/seeds/*.sql
*.log
.output.txt
venv/
.venv/
__pycache__/
.idea/
services/ml-analyzer/.env
node_modules/
.pytest_cache/
/.production

# Operations and agent material lives in the private ops repository.
# Its install.sh links these paths into a checkout; ignoring them keeps a linked
# checkout clean. No trailing slashes: they are symlinks, which "dir/" never matches.
# .claude is ignored as a whole, so .claude/worktrees stays local state.
# tests/ci/test_ops_material_not_tracked.py fails when any of them is tracked again.
/.claude
/.ai
/.junie
/services/muma-mobile/.junie
/scripts/prod
/scripts/crash-triage
/scripts/nightly-prod-check
/scripts/ssh
/scripts/vw.sh
/services/music-management-server/scripts/remote-build.sh
/docs/superpowers
/AGENTS.local.md
# Coverage reports
coverage/
coverage-python.xml
coverage-lms.xml
coverage-muma-server.xml
cobertura-muma-mobile.xml
# JUnit report, published by music-management:unit so failures show up in the
# merge request instead of only in the raw job log.
report-python.xml
htmlcov/
.coverage
.coverage.*
# Tool caches
.mypy_cache/
.ruff_cache/
# Local runtime data (dev/music bind-mount contents for docker/docker-compose.dev.yml).
/data/

# Core dumps. The emulator smoke test crashes hard enough to drop one of these
# next to the sources, and at ~1 GB each they filled the CI runners before
# anyone noticed three had been committed.
core.[0-9]*
