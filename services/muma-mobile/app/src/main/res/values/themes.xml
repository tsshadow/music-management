<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CleanSearchStyle" parent="Widget.AppCompat.SearchView">
        <item name="queryBackground">@drawable/pill_background</item>
        <item name="submitBackground">@null</item>
        <item name="android:paddingHorizontal">4dp</item>
    </style>

    <!-- The launcher trampoline (activity/LauncherActivity.kt) exists for one frame and must not
         draw anything, or a tap on the icon flashes a blank screen before the UI appears.
         Translucent rather than Theme.NoDisplay: NoDisplay crashes on newer Android when the
         activity reaches onResume before finishing, and a trampoline that starts another activity
         cannot guarantee it will not. -->
    <style name="LauncherTrampoline" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <!-- Here we define some basic attributes that are the same for each theme -->
    <style name="UltrasonicTheme.Base" parent="">
        <item name="searchViewStyle">@style/CleanSearchStyle</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <!-- The deepest level, so the system bars recede behind the app. Each style names its
             own through colorPrimaryDark; Base is an overlay applied on top of the chosen
             style, so the attribute resolves against that style. -->
        <item name="android:statusBarColor">?attr/colorPrimaryDark</item>
        <item name="android:navigationBarColor">?attr/colorPrimaryDark</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- The app as it has always looked. Every value below is what the layouts hardcoded before
         the style sweep, so this theme renders pixel-for-pixel as the previous release. -->
    <style name="UltrasonicTheme.Spotify" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/spotify_green</item>
        <item name="colorPrimaryDark">@color/spotify_black</item>
        <item name="colorAccent">@color/spotify_green</item>
        <item name="colorOnPrimary">@color/spotify_black</item>
        <item name="brandColorSets">@color/spotify_blue</item>

        <!-- Material3's secondary ramp, which this style used to leave at the library's baseline:
             a lavender #ccc2dc on #332d41, and a #4a4458 container. Both belong to no MuMa style
             and both were on screen - the missing-cover placeholder painted the whole player
             lavender and the navigation bar drew the purple container under the active
             destination. Declared here so that nothing the app has not themed by hand can reach
             Material's purple again: the accent pair is the brand, the container pair is a
             surface, exactly as elsewhere in this style. -->
        <item name="colorSecondary">@color/spotify_green</item>
        <item name="colorOnSecondary">@color/spotify_black</item>
        <item name="colorSecondaryContainer">@color/spotify_card</item>
        <item name="colorOnSecondaryContainer">@color/spotify_text_primary</item>
        <item name="android:colorBackground">@color/spotify_black</item>
        <item name="colorSurface">@color/spotify_black</item>
        <item name="colorSurfaceContainer">@color/spotify_light</item>
        <item name="colorSurfaceVariant">@color/spotify_card</item>
        <item name="colorSurfaceContainerHighest">@color/spotify_hover_light</item>
        <item name="colorControlNormal">@color/spotify_text_secondary</item>
        <item name="android:textColorPrimary">@color/spotify_text_primary</item>
        <item name="android:textColorSecondary">@color/spotify_text_secondary</item>

        <!-- This style has two ink ranks, so ranks 3 and 4 collapse onto rank 2. -->
        <item name="colorInkTertiary">@color/spotify_text_secondary</item>
        <item name="colorInkQuaternary">@color/spotify_text_secondary</item>
        <item name="colorHairline">@android:color/transparent</item>
        <!-- A filled star used to take the same grey as an empty one, so a rating read as
             five identical stars and the count had to be counted. Green is the style's own
             accent and measures 7.25:1 on the window. -->
        <item name="colorRating">@color/spotify_green</item>
        <!-- Both styles. It fills the error banner, which carries white text; the Home
             proposal's warm #d98324 is a text accent on a dark ground, and using it as a fill
             would drop that white text to 2.91:1. An error is red in both styles. -->
        <item name="colorWarn">@color/spotify_error_banner</item>
        <item name="colorNavSurface">@color/background_color_black</item>

        <item name="radiusRow">16dp</item>
        <item name="radiusSurface">24dp</item>
        <item name="radiusBanner">8dp</item>
        <item name="radiusThumb">4dp</item>

        <item name="listRowBackground">@drawable/song_card_background</item>
        <item name="rowSeam">@null</item>
        <item name="rowMarginVertical">2dp</item>
        <item name="rowMarginHorizontal">8dp</item>

        <item name="colorKicker">@color/spotify_green</item>
    </style>

    <!-- Only the values below differ. The brand colours do not: both styles mark songs green and
         sets blue, because the launcher icon, the glyph and the web frontend all use them. What
         separates the two styles is depth and warmth - Spotify has one dark level under the
         panel, MuMa has three - plus a seam between rows instead of a card around each one. -->
    <style name="UltrasonicTheme.Muma" parent="UltrasonicTheme.Spotify">
        <item name="colorPrimaryDark">@color/muma_deep</item>
        <item name="colorOnPrimary">@color/muma_ground</item>
        <item name="android:colorBackground">@color/muma_ground</item>

        <item name="colorInkTertiary">@color/muma_ink_tertiary</item>
        <item name="colorInkQuaternary">@color/muma_ink_quaternary</item>
        <item name="colorHairline">@color/muma_hairline</item>
        <item name="colorRating">@color/muma_rating</item>
        <item name="colorNavSurface">@color/muma_deep</item>

        <item name="radiusRow">4dp</item>
        <item name="radiusSurface">12dp</item>
        <item name="radiusBanner">4dp</item>
        <item name="radiusThumb">3dp</item>

        <item name="listRowBackground">@null</item>
        <item name="rowSeam">@drawable/list_row_hairline</item>
        <item name="rowMarginVertical">0dp</item>
        <item name="rowMarginHorizontal">0dp</item>

        <item name="colorKicker">@color/muma_ink_quaternary</item>
    </style>

</resources>