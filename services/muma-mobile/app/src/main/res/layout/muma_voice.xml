<?xml version="1.0" encoding="utf-8"?>
<!--
  The voice screen listens the moment it opens, so the microphone below is a repeat rather than a
  start button. Underneath it, what the request became, in words rather than in the filter JSON
  the server is sent.
-->
<ScrollView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:background="?attr/colorSurface"
    a:fillViewport="true">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center_horizontal"
        a:orientation="vertical"
        a:padding="24dp">

        <TextView
            a:id="@+id/muma_voice_status"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="16dp"
            a:gravity="center"
            a:text="@string/muma_voice_prompt"
            a:textAppearance="?attr/textAppearanceTitleLarge"
            a:textColor="?attr/colorOnSurface" />

        <TextView
            a:id="@+id/muma_voice_heard"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="12dp"
            a:gravity="center"
            a:textAppearance="?attr/textAppearanceBodyMedium"
            a:textColor="?attr/colorOnSurfaceVariant"
            tools:text="hardstyle uit 2021" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            a:id="@+id/muma_voice_mic"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:layout_marginTop="24dp"
            a:contentDescription="@string/muma_voice_title"
            a:src="@drawable/ic_menu_microphone"
            app:backgroundTint="?attr/colorPrimary"
            app:elevation="6dp"
            app:fabCustomSize="140dp"
            app:maxImageSize="64dp"
            app:tint="?attr/colorOnPrimary" />

        <com.google.android.material.chip.ChipGroup
            a:id="@+id/muma_voice_choices"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="24dp"
            a:visibility="gone" />

        <EditText
            a:id="@+id/muma_voice_input"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="24dp"
            a:autofillHints=""
            a:hint="@string/voice_diagnostics_hint"
            a:imeOptions="actionSearch"
            a:inputType="text"
            a:textColor="?attr/colorOnSurface"
            a:textColorHint="?attr/colorOnSurfaceVariant" />

        <View
            a:layout_width="match_parent"
            a:layout_height="1dp"
            a:layout_marginTop="24dp"
            a:background="?attr/rowSeam" />

        <!--
          The parsed request. Every row is a label and a value, because "genre Hardstyle" is what
          somebody wants to read back and the JSON array that carries it is not.
        -->
        <LinearLayout
            a:id="@+id/muma_voice_explanation"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="12dp"
            a:orientation="vertical" />

        <TextView
            a:id="@+id/muma_voice_raw_toggle"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:layout_marginTop="8dp"
            a:background="?attr/selectableItemBackground"
            a:paddingVertical="8dp"
            a:text="@string/voice_explain_raw_show"
            a:textAppearance="?attr/textAppearanceLabelLarge"
            a:textColor="?attr/colorPrimary"
            a:visibility="gone" />

        <HorizontalScrollView
            a:id="@+id/muma_voice_raw_scroll"
            a:layout_width="match_parent"
            a:layout_height="wrap_content"
            a:visibility="gone">

            <TextView
                a:id="@+id/muma_voice_raw"
                a:layout_width="wrap_content"
                a:layout_height="wrap_content"
                a:fontFamily="monospace"
                a:textAppearance="?attr/textAppearanceBodySmall"
                a:textColor="?attr/colorOnSurfaceVariant"
                a:textIsSelectable="true" />

        </HorizontalScrollView>

    </LinearLayout>

</ScrollView>
