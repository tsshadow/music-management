# Database Configuration
DB_HOST=db
DB_PORT=3306
DB_USER=music-management
DB_PASS=<>
DB_DB=music-management
MYSQL_ROOT_PASSWORD=

# App Configuration
debug=false
# Link to phpMyAdmin shown in the admin UI. Leave empty when you do not run it.
PHPMYADMIN_URL=
import_folder_path=/mnt/music/EPs/__TODO
music_folder_path=/mnt/music
eps_folder_path=/mnt/music/EPs
delimiter=/

# Host Paths (adjust if your host music path is different)
HOST_MUSIC_PATH=/mnt/music
HOST_DATA_PATH=/docker/music-management

# Database backups. HOST_BACKUP_PATH must be on a different disk than
# HOST_DATA_PATH -- a dump on the database's own disk survives none of the things
# a backup is for, and tools/db_backup.py refuses a destination inside the data
# directory. scripts/backup/install-systemd.sh checks the disk itself, which the
# job cannot do from inside its container.
HOST_BACKUP_PATH=/mnt/backups/muma
BACKUP_RETENTION_DAYS=14
# Age at which the newest backup counts as stale, for --check-stale and for
# /health/backup.
BACKUP_STALE_AFTER_HOURS=36
# Optional: a dedicated read-only account for the dump. Falls back to DB_USER,
# which lacks SHOW VIEW, TRIGGER and EVENT -- see scripts/backup/README.md for
# the grant.
BACKUP_DB_USER=
BACKUP_DB_PASS=

# ntfy base URL for alerts. The backup jobs push through this; without it they
# run and report nothing, which is the failure mode they exist to prevent.
NOTIFY_URL=

# Downloader Settings
# The tagger walks fixed folder names under music_folder_path (Soundcloud, Youtube, Telegram,
# Livesets, Podcasts, Top 100, Warm Up Mixes). Keep these paths on those names: a download
# folder elsewhere is downloaded to, but never tagged. See docs/self-hosting.md.
youtube_folder=/mnt/music/Youtube
youtube_video_folder=/mnt/music/Youtube_Video
youtube_archive=/mnt/music/archives/youtube
youtube_accounts=/mnt/music/Youtube/accounts.txt
soundcloud_folder=/mnt/music/Soundcloud
soundcloud_archive=/mnt/music/archives/soundcloud
soundcloud_accounts=/mnt/music/Soundcloud/accounts.txt
telegram_folder=/mnt/music/Telegram

# Telegram API (Get these from my.telegram.org)
telegram_api_id=
telegram_api_hash=
telegram_session=music-management
telegram_accounts=

# Docker Configuration
DOCKER_USER=muma
# Image names, one per image ./build.sh builds and docker/docker-compose.yml runs as
# ${DOCKER_USER}/${IMAGE_...}:${IMAGE_TAG:-latest}. The defaults work for a single host
# without a registry: build with ./build.sh, then start the stack. IMAGE_BASE has to stay
# muma-base, the Dockerfiles name it. IMAGE_CORE is music-manager in build.sh as well.
IMAGE_BASE=muma-base
IMAGE_CORE=music-manager
IMAGE_IMPORTER=music-management-importer
IMAGE_DOWNLOADER=music-management-downloader
IMAGE_TELEGRAM=music-management-telegram
IMAGE_TOOLS=music-management-tools
IMAGE_ML=music-management-ml

# Which source workers run: importer, youtube, soundcloud, telegram (comma separated).
# See docs/self-hosting.md. Empty runs the core services only.
COMPOSE_PROFILES=

# Login of the firefox container (user FIREFOX_USER, default admin). No default password:
# set a long one. It starts with the youtube or soundcloud profile and publishes port 7003
# on 127.0.0.1; FIREFOX_BIND_ADDRESS=0.0.0.0 (or a LAN address) opens it to other machines.
FIREFOX_PASSWORD=
# FIREFOX_BIND_ADDRESS=127.0.0.1

# Where the workers reach music-manager to announce a tagged file. Inside the compose network
# this is the service name; change it only when music-manager runs elsewhere.
AUTH_SERVICE_URL=http://music-manager:8000

# Security
MUMA_API_KEY=<>
# API_KEY=
# USER_API_KEY=
# RATING_API_KEY=
# SCROBBLE_API_KEY=

# Subsonic API key the radio scheduler authenticates to LMS with. Set the same
# value here and in services/music-management-server/.env, since both stacks have
# to agree on it. MUMA_SERVER_SUBSONIC_API_KEY overrides it when set; the fallback
# is applied in Python (services/music_manager/lms_subsonic.py), NOT as a nested
# compose default -- docker-compose v1 renders "${A:-${B}}" as a literal string.
LMS_SUBSONIC_API_KEY=
# MUMA_SERVER_SUBSONIC_API_KEY=

# Rate limiting on /api/auth/login, /api/auth/refresh and /api/auth/setup.
# A user's api_key is accepted in place of their password (see
# docs/authentication.md), so an unlimited login endpoint is a guessing oracle
# against it. Counted over a sliding window, and only *rejected* attempts count:
# LMS re-checks the password against /api/auth/login on every Subsonic request,
# so successful traffic here is a library being browsed, not people logging in.
# A login is counted per account; the other two per client address, taken from
# the left-most X-Forwarded-For entry when behind a proxy.
# The counters are per process -- if music-manager is ever scaled to more than
# one replica these need to move to a shared store.
# AUTH_RATE_LIMIT_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_ENABLED=1

# Google Sign-In (RBAC / UserRequest flow)
# OAuth 2.0 "Web application" Client ID from Google Cloud Console. Used by
# music_manager to verify the `aud` claim of Google ID tokens sent by the web
# frontend and the Android app (the Android app must request its ID token
# with this same Web Client ID as the serverClientId/audience).
# IMPORTANT: must be the SAME value as VITE_GOOGLE_CLIENT_ID in
# services/music-management-server/.env, which is passed as a build-arg when
# building the LMS/frontend image. If they differ, the frontend's Google
# Sign-In button will render, but the backend will reject its ID token
# (audience mismatch, HTTP 401). See docs/self-hosting.md for the setup steps.
GOOGLE_CLIENT_ID=

# Where users of this server get its source code (AGPL-3.0 section 13). The About and
# login screens link to it. Set it to your repository or fork; the default is a placeholder.
PUBLIC_SOURCE_URL=https://github.com/OWNER/music-management

# Artist Image Fetcher
ARTIST_IMAGE_STORAGE_PATH=/mnt/music/artists
ARTIST_IMAGE_PUBLIC_BASE_URL=/media/artist-images
ARTIST_IMAGE_DISABLE_FALLBACK=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
LASTFM_API_KEY=

# Remote Deployment (optional)
# Descriptive name for the deployment target (e.g., "Production Stack")
DEPLOY_TARGET_NAME=

# PORTAINER_WEBHOOK_URL is not used by scripts/deploy.sh, which refuses to run while it is set:
# a webhook recreates the stack before the backup and the schema step. Deploy over SSH.

# SSH-based deployment
REMOTE_HOST=
REMOTE_USER=
REMOTE_PASS=
# Path to docker-compose.yml or its directory on the remote host
REMOTE_STACK_PATH=

# Option 3: Portainer Master Host (for template discovery)
# If your stack is managed by Portainer, the script can pull the template from here.
PORTAINER_HOST=
PORTAINER_HOST_USER=
PORTAINER_HOST_PASS=
