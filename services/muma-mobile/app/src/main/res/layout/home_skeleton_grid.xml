<?xml version="1.0" encoding="utf-8"?>
<!-- Stands in for the two-column shortcuts grid while it loads. Row heights match
     home_card_grid.xml so the real cards do not shift the page when they arrive. -->
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="wrap_content"
    a:orientation="vertical"
    a:paddingHorizontal="10dp">

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="horizontal">

        <View
            a:layout_width="0dp"
            a:layout_height="56dp"
            a:layout_marginHorizontal="4dp"
            a:layout_marginVertical="4dp"
            a:layout_weight="1"
            a:background="@drawable/skeleton_block" />

        <View
            a:layout_width="0dp"
            a:layout_height="56dp"
            a:layout_marginHorizontal="4dp"
            a:layout_marginVertical="4dp"
            a:layout_weight="1"
            a:background="@drawable/skeleton_block" />

    </LinearLayout>

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="horizontal">

        <View
            a:layout_width="0dp"
            a:layout_height="56dp"
            a:layout_marginHorizontal="4dp"
            a:layout_marginVertical="4dp"
            a:layout_weight="1"
            a:background="@drawable/skeleton_block" />

        <View
            a:layout_width="0dp"
            a:layout_height="56dp"
            a:layout_marginHorizontal="4dp"
            a:layout_marginVertical="4dp"
            a:layout_weight="1"
            a:background="@drawable/skeleton_block" />

    </LinearLayout>

</LinearLayout>
