<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="140dp"
    a:layout_height="wrap_content"
    a:background="?attr/selectableItemBackground"
    a:orientation="vertical"
    a:paddingHorizontal="6dp"
    a:paddingVertical="4dp">

    <com.google.android.material.imageview.ShapeableImageView
        a:id="@+id/card_image"
        a:layout_width="128dp"
        a:layout_height="128dp"
        a:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.SmallComponent"
        tools:src="@drawable/unknown_album" />

    <TextView
        a:id="@+id/card_title"
        a:layout_width="128dp"
        a:layout_height="wrap_content"
        a:layout_marginTop="8dp"
        a:ellipsize="end"
        a:maxLines="1"
        a:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        a:textColor="@color/spotify_text_primary"
        a:textStyle="bold"
        tools:text="Headhunterz" />

    <TextView
        a:id="@+id/card_subtitle"
        a:layout_width="128dp"
        a:layout_height="wrap_content"
        a:ellipsize="end"
        a:maxLines="1"
        a:textAppearance="@style/TextAppearance.Material3.LabelSmall"
        a:textColor="@color/spotify_text_secondary"
        tools:text="Artist" />

</LinearLayout>
