<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:title="@string/common_appname">

    <PreferenceCategory
        a:title="@string/server_selector.label"
        app:iconSpaceReserved="false">
        <Preference
            a:key="server_settings"
            a:title="@string/server_selector.label"
            a:icon="@drawable/ic_menu_select_server"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        a:title="@string/settings.appearance_title"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.web_ui"
            a:summary="@string/settings.web_ui_summary"
            a:title="@string/settings.web_ui_title"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="true"
            a:key="@string/setting_key.canonical_only"
            a:summary="@string/settings.canonical_only_summary"
            a:title="@string/settings.canonical_only_title"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="true"
            a:key="@string/setting_key.separate_home_history"
            a:summary="@string/settings.separate_home_history_summary"
            a:title="@string/settings.separate_home_history_title"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="8"
            a:entries="@array/homeShortcutCounts"
            a:entryValues="@array/homeShortcutCounts"
            a:key="@string/setting_key.home_shortcut_count"
            a:summary="@string/settings.home_shortcut_count_summary"
            a:title="@string/settings.home_shortcut_count_title"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="5"
            a:entries="@array/homeListCounts"
            a:entryValues="@array/homeListCounts"
            a:key="@string/setting_key.home_list_count"
            a:summary="@string/settings.home_list_count_summary"
            a:title="@string/settings.home_list_count_title"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <!-- One row per home section, in the order they appear on the screen. Everything set to a
         button shares the grid at the top; everything set to an overview keeps its own heading
         below it. See docs/designs/home-sections/functional.md. -->
    <PreferenceCategory
        a:summary="@string/settings.home_summary"
        a:title="@string/settings.home_title"
        app:iconSpaceReserved="false">
        <ListPreference
            a:defaultValue="BUTTON"
            a:entries="@array/homeSectionModeNamesNoOverview"
            a:entryValues="@array/homeSectionModeValuesNoOverview"
            a:key="@string/setting_key.home_mode_memories"
            a:title="@string/home.memories"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="BUTTON"
            a:entries="@array/homeSectionModeNames"
            a:entryValues="@array/homeSectionModeValues"
            a:key="@string/setting_key.home_mode_release_radar"
            a:title="@string/home.release_radar"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="BUTTON"
            a:entries="@array/homeSectionModeNames"
            a:entryValues="@array/homeSectionModeValues"
            a:key="@string/setting_key.home_mode_daily_mix"
            a:title="@string/home.daily_mix"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="2"
            a:entries="@array/homeListCounts"
            a:entryValues="@array/homeListCounts"
            a:key="@string/setting_key.home_count_daily_mix"
            a:title="@string/settings.home_count_daily_mix_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="OFF"
            a:entries="@array/homeSectionModeNames"
            a:entryValues="@array/homeSectionModeValues"
            a:key="@string/setting_key.home_mode_favorites"
            a:title="@string/home.favorites"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="4"
            a:entries="@array/homeListCounts"
            a:entryValues="@array/homeListCounts"
            a:key="@string/setting_key.home_count_favorites"
            a:title="@string/settings.home_count_favorites_title"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="OVERVIEW"
            a:entries="@array/homeSectionModeNames"
            a:entryValues="@array/homeSectionModeValues"
            a:key="@string/setting_key.home_mode_shortcuts"
            a:title="@string/home.shortcuts"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="OVERVIEW"
            a:entries="@array/homeSectionModeNames"
            a:entryValues="@array/homeSectionModeValues"
            a:key="@string/setting_key.home_mode_recently_released"
            a:title="@string/home.recently_released"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
        <ListPreference
            a:defaultValue="OVERVIEW"
            a:entries="@array/homeSectionModeNames"
            a:entryValues="@array/homeSectionModeValues"
            a:key="@string/setting_key.home_mode_recently_added"
            a:title="@string/home.recently_added"
            app:iconSpaceReserved="false"
            app:useSimpleSummaryProvider="true"/>
    </PreferenceCategory>

    <PreferenceCategory
        a:title="@string/settings.appearance_title"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            a:defaultValue="true"
            a:key="@string/setting_key.display_bitrate_with_artist"
            a:summary="@string/settings.display_bitrate_summary"
            a:title="@string/settings.display_bitrate"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.show_track_number"
            a:summary="@string/settings.show_track_number_summary"
            a:title="@string/settings.show_track_number"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="2"
            a:entries="@array/trackListLinesNames"
            a:entryValues="@array/trackListLinesValues"
            a:key="@string/setting_key.track_list_lines"
            a:summary="@string/settings.track_list_lines_summary"
            a:title="@string/settings.track_list_lines"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.disc_sort"
            a:summary="@string/settings.disc_sort_summary"
            a:title="@string/settings.disc_sort"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/settings.playback_control_title"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.resume_play_on_headphones_plug"
            a:title="@string/settings.playback.resume_play_on_headphones_plug.title"
            a:summary="@string/settings.playback.resume_play_on_headphones_plug.summary"
            app:iconSpaceReserved="false"/>
        <Preference
            a:key="@string/setting_key.resume_on_bluetooth_device"
            a:title="@string/settings.playback.resume_on_bluetooth_device"
            app:iconSpaceReserved="false"/>
        <Preference
            a:key="@string/setting_key.pause_on_bluetooth_device"
            a:title="@string/settings.playback.pause_on_bluetooth_device"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.hardware_offload"
            a:summary="@string/settings.use_hw_offload_description"
            a:title="@string/settings.use_hw_offload_title"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/car_mode.settings_category"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.car_mode_manual"
            a:summary="@string/car_mode.manual_summary"
            a:title="@string/car_mode.manual"
            app:iconSpaceReserved="false" />
        <MultiSelectListPreference
            a:key="@string/setting_key.car_mode_devices"
            a:summary="@string/car_mode.devices_summary"
            a:title="@string/car_mode.devices"
            app:iconSpaceReserved="false" />
        <Preference
            a:key="car_mode_full_screen"
            a:summary="@string/car_mode.full_screen_summary"
            a:title="@string/car_mode.full_screen"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/settings.network_title"
        app:iconSpaceReserved="false">
        <ListPreference
            a:defaultValue="0"
            a:entries="@array/maxBitrateNames"
            a:entryValues="@array/maxBitrateValues"
            a:key="@string/setting_key.max_bitrate_mobile"
            a:title="@string/settings.max_bitrate_mobile"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="0"
            a:entries="@array/maxBitrateNames"
            a:entryValues="@array/maxBitrateValues"
            a:key="@string/setting_key.max_bitrate_wifi"
            a:title="@string/settings.max_bitrate_wifi"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="320"
            a:entries="@array/maxBitrateNames"
            a:entryValues="@array/maxBitrateValues"
            a:key="@string/setting_key.max_bitrate_pinning"
            a:title="@string/settings.max_bitrate_pinning"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.wifi_required_for_download"
            a:summary="@string/settings.wifi_required_summary"
            a:title="@string/settings.wifi_required_title"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key_auto_switch_offline"
            a:summary="@string/settings.auto_switch_offline_summary"
            a:title="@string/settings.auto_switch_offline"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="60000"
            a:entries="@array/networkTimeoutNames"
            a:entryValues="@array/networkTimeoutValues"
            a:key="@string/setting_key.network_timeout"
            a:title="@string/settings.network_timeout"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/settings.cache_title"
        app:iconSpaceReserved="false">
        <ListPreference
            a:defaultValue="25000"
            a:entries="@array/cacheSizeNames"
            a:entryValues="@array/cacheSizeValues"
            a:key="@string/setting_key.cache_size"
            a:title="@string/settings.cache_size"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:key="@string/setting_key.custom_cache_location"
            a:title="@string/settings.custom_cache_location"
            app:iconSpaceReserved="false"/>
        <Preference
            a:key="@string/setting_key.cache_location"
            a:title="@string/settings.cache_location"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue="100"
            a:entries="@array/preloadCountNames"
            a:entryValues="@array/preloadCountValues"
            a:key="@string/setting_key.preload_count"
            a:title="@string/settings.preload"
            app:iconSpaceReserved="false"/>
        <SeekBarPreference
            a:min="1"
            a:defaultValue="3"
            a:max="10"
            app:showSeekBarValue="true"
            a:key="@string/setting_key.parallel_downloads"
            a:title="@string/settings.parallel_downloads"
            app:iconSpaceReserved="false"
            tools:ignore="UnusedAttribute" />
        <ListPreference
            a:defaultValue="300"
            a:entries="@array/directoryCacheTimeNames"
            a:entryValues="@array/directoryCacheTimeValues"
            a:key="@string/setting_key.directory_cache_time"
            a:title="@string/settings.directory_cache_time"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.media_device_export"
            a:summary="@string/setting_media_device_export_summary"
            a:title="@string/setting_media_device_export_title"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/settings.search_title"
        app:iconSpaceReserved="false">
        <ListPreference
            a:defaultValue="100"
            a:entries="@array/searchNames"
            a:entryValues="@array/searchValues"
            a:key="@string/setting_key.genre_track_limit"
            a:title="@string/settings.genre_track_limit"
            a:summary="@string/settings.genre_track_limit_summary"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/settings.other_title"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            a:defaultValue="true"
            a:key="@string/setting_key.scrobble"
            a:summary="@string/settings.scrobble_summary"
            a:title="@string/settings.scrobble_title"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.hide_media"
            a:summary="@string/settings.hide_media_summary"
            a:title="@string/settings.hide_media_title"
            app:iconSpaceReserved="false"/>
        <ListPreference
            a:defaultValue=""
            a:entries="@array/languageNames"
            a:entryValues="@array/languageValues"
            a:key="@string/setting_key.override_language"
            a:title="@string/settings.override_language"
            a:summary="@string/settings.override_language_summary"
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.show_confirmation_dialog"
            a:title="@string/settings.show_confirmation_dialog"
            a:summary="@string/settings.show_confirmation_dialog_summary"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        a:title="@string/settings.muma_sync_title"
        app:iconSpaceReserved="false">
        <EditTextPreference
            a:key="@string/setting_key.muma_user_id"
            a:title="@string/settings.muma_user_id_title"
            a:summary="@string/settings.muma_user_id_summary"
            a:inputType="number"
            app:iconSpaceReserved="false"/>
        <EditTextPreference
            a:key="@string/setting_key.muma_api_key"
            a:title="@string/settings.muma_api_key_title"
            a:summary="@string/settings.muma_api_key_summary"
            a:inputType="textPassword"
            app:iconSpaceReserved="false"/>
        <!-- Deliberately outside the debug category, which is hidden in release builds:
             this is the one diagnostics action a user needs on a release build. -->
        <Preference
            a:key="@string/setting_key.send_diagnostics"
            a:title="@string/settings.diagnostics.send_now"
            a:summary="@string/settings.diagnostics.send_now_summary"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory
        a:title="@string/settings.debug.title"
        app:iconSpaceReserved="false">
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.debug_log_to_file"
            a:title="@string/settings.debug.log_to_file"
            a:summary=""
            app:iconSpaceReserved="false"/>
        <CheckBoxPreference
            a:defaultValue="false"
            a:key="@string/setting_key.crash_detection"
            a:title="@string/settings.debug.crash_detection"
            a:summary="@string/settings.debug.crash_detection_summary"
            app:iconSpaceReserved="false"/>
        <Preference
            a:key="@string/setting_key.view_log"
            a:title="@string/settings.debug.view_log"
            app:iconSpaceReserved="false"/>
        <Preference
            a:key="@string/setting_key.share_log"
            a:title="@string/settings.debug.share_log"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

</PreferenceScreen>
