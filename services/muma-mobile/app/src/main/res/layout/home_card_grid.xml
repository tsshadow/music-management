<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:a="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    a:layout_width="match_parent"
    a:layout_height="56dp"
    a:layout_marginHorizontal="4dp"
    a:layout_marginVertical="4dp"
    app:cardBackgroundColor="?attr/colorSurfaceVariant"
    app:cardCornerRadius="4dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        a:layout_width="match_parent"
        a:layout_height="match_parent"
        a:background="?attr/selectableItemBackground">

        <com.google.android.material.imageview.ShapeableImageView
            a:id="@+id/card_image"
            a:layout_width="56dp"
            a:layout_height="56dp"
            a:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/unknown_album" />

        <!-- Title and source are one vertically centred block: a card in the shared grid has to
             say what it is *and* which section put it there, because the grid has no headings and
             the same album can arrive from Favorieten and from the shortcuts alike. The title drops
             to one line when there is a source to show; HomeCardAdapter does that, because whether
             there is one is a property of the card. -->
        <TextView
            a:id="@+id/card_title"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_marginStart="10dp"
            a:layout_marginEnd="8dp"
            a:ellipsize="end"
            a:maxLines="2"
            a:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            a:textColor="?android:attr/textColorPrimary"
            a:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/card_subtitle"
            app:layout_constraintEnd_toStartOf="@+id/card_favorite"
            app:layout_constraintStart_toEndOf="@+id/card_image"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Recent Hardstyle" />

        <TextView
            a:id="@+id/card_subtitle"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_marginStart="10dp"
            a:layout_marginEnd="8dp"
            a:ellipsize="end"
            a:maxLines="1"
            a:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            a:textColor="?android:attr/textColorSecondary"
            a:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/card_favorite"
            app:layout_constraintStart_toEndOf="@+id/card_image"
            app:layout_constraintTop_toBottomOf="@+id/card_title"
            tools:text="favoriet"
            tools:visibility="visible" />

        <ImageView
            a:id="@+id/card_favorite"
            a:layout_width="16dp"
            a:layout_height="16dp"
            a:layout_marginEnd="8dp"
            a:contentDescription="@string/favorite"
            a:src="@drawable/ic_star_full"
            a:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:visibility="visible" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
