<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/welcome_title"
            android:textColor="@color/spotify_text_primary"
            android:textAppearance="?attr/textAppearanceTitleLarge" />

        <ImageButton
            android:id="@+id/welcome_skip_button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/welcome_skip_button"
            android:src="@drawable/ic_menu_close"
            app:tint="@color/spotify_text_secondary" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:gravity="center"
        android:text="@string/welcome_login_info"
        android:textColor="@color/spotify_text_secondary"
        android:textAppearance="?attr/textAppearanceBodyMedium" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/welcome_username_layout"
        style="@style/Ultrasonic.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/welcome_username">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/welcome_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/welcome_password_layout"
        style="@style/Ultrasonic.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/welcome_password"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/welcome_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/spotify_card" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="@string/welcome_or_divider"
            android:textAllCaps="true"
            android:textColor="@color/spotify_text_secondary"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceLabelSmall" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="@color/spotify_card" />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/welcome_google_signin"
        style="@style/Ultrasonic.Button.Google"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/google_signin_button"
        app:icon="@drawable/ic_google_logo" />

    <ProgressBar
        android:id="@+id/welcome_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/welcome_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/rounded_error_banner"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:visibility="gone" />

    <TextView
        android:id="@+id/welcome_target_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:alpha="0.5"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceCaption"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/welcome_connectivity_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:alpha="0.7"
        android:textColor="@color/spotify_text_secondary"
        android:textAppearance="?attr/textAppearanceCaption"
        android:text="@string/welcome_status_checking" />

</LinearLayout>
