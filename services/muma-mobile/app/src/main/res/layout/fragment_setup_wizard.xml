<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:a="http://schemas.android.com/apk/res/android"
    a:layout_width="match_parent"
    a:layout_height="match_parent"
    a:orientation="vertical">

    <androidx.viewpager2.widget.ViewPager2
        a:id="@+id/wizard_pager"
        a:layout_width="match_parent"
        a:layout_height="0dp"
        a:layout_weight="1" />

    <TextView
        a:id="@+id/wizard_progress"
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:gravity="center"
        a:paddingTop="8dp"
        a:paddingBottom="8dp"
        a:textColor="?android:attr/textColorSecondary"
        a:textSize="12sp" />

    <LinearLayout
        a:layout_width="match_parent"
        a:layout_height="wrap_content"
        a:orientation="horizontal"
        a:padding="16dp">

        <com.google.android.material.button.MaterialButton
            a:id="@+id/wizard_back"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:text="@string/wizard.back" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/wizard_skip"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            a:layout_width="0dp"
            a:layout_height="wrap_content"
            a:layout_weight="1"
            a:text="@string/wizard.skip" />

        <com.google.android.material.button.MaterialButton
            a:id="@+id/wizard_next"
            a:layout_width="wrap_content"
            a:layout_height="wrap_content"
            a:text="@string/wizard.next" />
    </LinearLayout>
</LinearLayout>
