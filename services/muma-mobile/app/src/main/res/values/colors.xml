<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="background_color_black">#000000</color>
    <color name="selected_menu_dark">#FFFFFF</color>
    <color name="selected_menu_light">#191414</color>

    <!-- Spotify branding -->
    <color name="spotify_green">#1db954</color>
    <color name="spotify_blue">#2d5afc</color>
    <color name="spotify_black">#121212</color>
    <color name="spotify_dark">#000000</color>
    <color name="spotify_light">#181818</color>
    <color name="spotify_card">#282828</color>
    <color name="spotify_hover_light">#3e3e3e</color>
    <color name="spotify_text_primary">#ffffff</color>
    <color name="spotify_text_secondary">#b3b3b3</color>

    <!-- Ultrasonic indigo. The launcher icon uses the original #3f51b5, but that measures
         2.73:1 against #121212, below the 3:1 floor for UI components, so the in-app accent
         is Indigo 300 at 5.43:1 — on par with the green's 6.96:1. -->
    <color name="muma_indigo">#7986cb</color>

    <!-- Loading placeholders: one step lighter than a card, so a skeleton reads as "content is
         coming" rather than as an empty card -->
    <color name="skeleton_block">#2f2f2f</color>

    <!-- Status banners (Google auth request states) - mirrors the web frontend's
         bg-*-500/20 text-*-400 Tailwind pattern (docs/styleguide.md semantic colors) -->
    <color name="status_info_bg">#3329b6f6</color>
    <color name="status_info_text">#29b6f6</color>
    <color name="status_success_bg">#331db954</color>
    <color name="status_success_text">#1db954</color>
    <color name="status_error_bg">#33e53935</color>
    <color name="status_error_text">#e53935</color>

    <!-- Matches the web frontend's error banner (bg-[#e91429]) -->
    <color name="spotify_error_banner">#e91429</color>

    <!-- "Sign in with Google" button, per Google's own branding guidelines
         (light theme, neutral text/border regardless of the app's dark theme) -->
    <color name="google_button_background">#ffffff</color>
    <color name="google_button_text">#1f1f1f</color>
    <color name="google_button_stroke">#747775</color>
</resources>